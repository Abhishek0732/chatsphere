# ─── ChatSphere environment ───────────────────────────────────────────────
# Copy this file to ".env" and tweak as needed:
#     cp .env.example .env
# Used by docker-compose.yml. Never commit your real ".env" (it holds secrets).

# Host that browsers use to reach this stack.
#  - "localhost"      -> only this machine
#  - "<your-LAN-IP>"  -> shareable with others on the same network (e.g. 192.168.1.50)
# After changing this you MUST rebuild the frontend (URLs are baked in at build time):
#   docker compose up -d --build frontend backend
PUBLIC_HOST=localhost

# MySQL
MYSQL_DATABASE=chatsphere
MYSQL_USER=chatsphere
MYSQL_PASSWORD=chatsphere_pw
MYSQL_ROOT_PASSWORD=root_pw
# Host port only (container-internal port stays 3306). 3306 is often taken on dev hosts.
MYSQL_PORT=3307

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092

# MinIO (S3-compatible object storage for uploaded media)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=chatsphere-media

# Backend
BACKEND_PORT=8080
# IMPORTANT: change this to your own random 256-bit+ secret before any real use.
JWT_SECRET=change-me-super-secret-key-at-least-256-bits-long-for-hs256-signing!!
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Frontend
FRONTEND_PORT=5173

# Adminer (DB UI)
ADMINER_PORT=8081

# CORS allowed origins for the backend. "*" allows any origin; set an explicit
# comma-separated list to lock it down for production.
# CORS_ALLOWED_ORIGINS=*

# ─── Mail (signup OTP + password reset) ───────────────────────────────────
# Default: the bundled Mailpit dev inbox — nothing leaves this machine.
# Read the mails at http://${PUBLIC_HOST}:${MAILPIT_UI_PORT}
MAILPIT_UI_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=ChatSphere <no-reply@chatsphere.local>
# Require OTP email verification on signup. Set false to bypass it (tests/seeding).
APP_REQUIRE_EMAIL_VERIFICATION=true

# To send real mail from Gmail: create a 16-char App Password at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on),
# then comment out the block above and uncomment these:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# APP_MAIL_FROM=ChatSphere <you@gmail.com>

# ─── Status music catalogue ───────────────────────────────────────────────
# Storefront the song search uses: decides what counts as "trending" and which
# regional music is returned (IN = India, US, GB, …).
MUSIC_COUNTRY=IN

# ─── Media plane (voice/video calls) ──────────────────────────────────────
# Coturn TURN server — relays calls between peers on different networks.
# SECRETS: generate your own, never reuse these placeholders.
COTURN_SECRET=change-me-turn-shared-secret

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Makes notifications arrive when the app is CLOSED. Without these, push simply
# stays off and notifications only reach an open tab — everything else works.
# Generate your own:  node scripts/generate-vapid-keys.mjs
# Keep them stable: changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatsphere.dev
