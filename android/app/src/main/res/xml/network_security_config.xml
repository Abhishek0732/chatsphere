<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow plain http (e.g. a LAN IP) as well as https, and trust
         user-installed CAs so a self-signed tunnel cert also works. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
